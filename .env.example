# =============================================================================
# Trip Planner — environment variables. Copy to .env and fill in.
# =============================================================================

# --- LLM ---
LLM_PROVIDER=openai          # openai | anthropic
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...   # only when LLM_PROVIDER=anthropic

# Model routing: empty = provider default (see trip_planner/llm.py)
#                 openai                anthropic
# PLANNER_MODEL=  gpt-5.5 (medium)      claude-sonnet-5-5 (medium)   decisions + trip edits
# RESEARCH_MODEL= gpt-5.4-mini (low)    claude-haiku-4-5             research sub-agent
# JUDGE_MODEL=    gpt-5.5 (high)        claude-opus-5-5 (high)       eval grading only
# PLANNER_EFFORT= / RESEARCH_EFFORT= / JUDGE_EFFORT=   low | medium | high

# --- Data APIs ---
SERPAPI_API_KEY=...          # flights + hotels (Google Flights / Google Hotels)
APIFY_API_TOKEN=apify_api_...  # place search via Apify's Google Maps scraper (compass/crawler-google-places)
# PLACES_PROVIDER=apify      # apify (default) | google
GOOGLE_MAPS_API_KEY=...      # Routes API for travel times (+ Places API (New) if PLACES_PROVIDER=google)
# GOOGLE_PLACES_API_KEY=...  # optional separate key for Places
TAVILY_API_KEY=tvly-...      # web search
OPENWEATHERMAP_API_KEY=...   # 5-day forecast

# TOOL_TIMEOUT_SECONDS=20
# CACHE_TTL_HOURS=12

# --- Storage ---
# App tables (trips index, preferences, tool cache)
# APP_DB_URL=sqlite+aiosqlite:///./data/trip_planner.db
# APP_DB_URL=postgresql+asyncpg://atp:atp@localhost:5432/trip_planner
# LangGraph checkpoints: empty = SQLite file in data/, or a Postgres URL (psycopg format)
# CHECKPOINT_URL=postgresql://atp:atp@localhost:5432/trip_planner

# --- API ---
# APP_API_KEY=change-me      # set to require "Authorization: Bearer <key>"
# RATE_LIMIT_PER_MINUTE=20
# HOST=127.0.0.1
# PORT=8000

# --- Tracing (optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=trip-planner
