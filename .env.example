
# =============================================================================
# AgenticTripPlanner — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- LLM Providers ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Default model per tier (override per-agent in config/model_config.py)
SUPERVISOR_MODEL=gpt-4o
FAST_MODEL=gpt-4o-mini
VALIDATOR_MODEL=gpt-4o

# Prompt version to load (maps to prompts/v1/, prompts/v2/, etc.)
PROMPT_VERSION=v1

# --- LangSmith Observability (optional but recommended) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=agentictripplanner

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentictripplanner
# For checkpointer (uses psycopg3, not asyncpg):
CHECKPOINT_DB_URL=postgresql://postgres:postgres@localhost:5432/agentictripplanner

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_TTL_SECONDS=3600

# --- ChromaDB (Vector Store) ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_TRIP_MEMORY=trip_memory

# --- External Travel APIs ---
SERPAPI_API_KEY=your_serpapi_key_here

OPENWEATHERMAP_API_KEY=...

FOURSQUARE_API_KEY=...    # Foursquare Places API v3 key — free at foursquare.com/developers
GOOGLE_MAPS_API_KEY=...  # Only needed for travel distance (tools/maps.py); optional if MOCK_FALLBACK=true

TAVILY_API_KEY=tvly-...

TRIPADVISOR_API_KEY=...  # Free tier: 5k calls/day — get at tripadvisor-content-api.readme.io

EXCHANGE_RATES_API_KEY=...

# --- Application ---
APP_ENV=development         # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR

# Mock fallback: set to true to run with zero real API keys (uses realistic mocks)
MOCK_FALLBACK=false

# MCP server integration (requires Node.js / npx on PATH)
# When true, spins up @tripadvisor/tripadvisor-mcp as a subprocess tool server
MCP_ENABLED=false

# Max retries for external API calls
TOOL_MAX_RETRIES=3
TOOL_TIMEOUT_SECONDS=30

# LangGraph execution limits
MAX_REVISION_CYCLES=2
VALIDATOR_PASS_THRESHOLD=0.75
MAX_GRAPH_STEPS=50

# --- Streamlit UI ---
FASTAPI_BASE_URL=http://localhost:8000
